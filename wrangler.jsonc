// Konfigurasi Cloudflare untuk APLIKASI WEB (file statis hasil `npm run build`).
// Nama sengaja berbeda dari Worker API (`audit-task-force`, folder worker/) agar tidak saling menimpa.
{
  "name": "task-force-audit-app",
  "compatibility_date": "2026-09-01",
  // Selalu aktifkan alamat https://task-force-audit-app.ariandialnotri.workers.dev
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
